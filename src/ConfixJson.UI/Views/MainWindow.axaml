<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConfixJson.UI.ViewModels"
        xmlns:models="using:ConfixJson.Core.Models"
        xmlns:conv="clr-namespace:ConfixJson.UI.Converters"
        xmlns:controls="using:ConfixJson.UI.Controls"
        xmlns:views="using:ConfixJson.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ConfixJson.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="{Binding DocumentFilename}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>

    <!-- Help meta constraint items -->
    <ItemsPanelTemplate x:Key="MetaItemsPanel">
      <WrapPanel />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="MetaItemTemplate" x:DataType="models:MetaItem">
      <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,14,0">
        <TextBlock Text="{Binding Label, StringFormat={}{0}:}" Classes="HelpMetaLabel" />
        <TextBlock Text="{Binding Value}" Classes="HelpMetaValue" />
      </StackPanel>
    </DataTemplate>

  </Window.Resources>

  <Panel>

    <!-- ===== MAIN LAYOUT ===== -->
    <DockPanel>

      <!-- ===== TOP HEADER ===== -->
      <Border Classes="Toolbar TopHeader" DockPanel.Dock="Top" Padding="14,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left">
            <TextBlock Text="JSON EDITOR" Classes="HeaderLabel" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DocumentFilename}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsSchemaStatusVisible}">
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaLoaded}">
              <TextBlock Text="✓ Schema" Foreground="{DynamicResource AccentBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="10" FontWeight="Bold" />
            </Button>
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaNone}">
              <TextBlock Text="⚠ Kein Schema" Foreground="{DynamicResource WarnBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="10" FontWeight="Bold" />
            </Button>
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaFailed}">
              <TextBlock Text="⚠ Schemafehler" Foreground="{DynamicResource ErrorBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="10" FontWeight="Bold" />
            </Button>
          </StackPanel>
          <Border Classes="StatusError" IsVisible="{Binding HasErrors}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} errors}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="9" FontWeight="Bold" />
          </Border>
          <Border Classes="StatusSuccess" IsVisible="{Binding ShowSaved}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="saved" Foreground="{DynamicResource AccentBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="9" FontWeight="Bold" />
            </Border>
          </DockPanel>
        </Border>

        <Border Classes="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasLoadError}">
          <TextBlock Text="{Binding LoadError}" Classes="ErrorText" TextWrapping="Wrap" />
        </Border>

      <!-- ===== BODY ===== -->
      <Grid ColumnDefinitions="240,*">
        <!-- ===== TREE PANEL ===== -->
         <Border Grid.Column="0" BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource AccentBrush}"
                Background="{DynamicResource TreeBackgroundBrush}">
          <Grid RowDefinitions="Auto,*,Auto">
            <!-- Tree Search -->
            <TextBox Grid.Row="0" PlaceholderText="Filter..." 
                     FontFamily="{StaticResource FontJetBrainsMono}"
                     FontSize="11" Padding="6,4"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderBrush="{DynamicResource PanelBorderBrush}"
                     BorderThickness="0,0,0,1"
                     Margin="0" />
            <!-- Tree Scroll Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding TreeRootNodes}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <views:TreeDataTemplate />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Tree Toolbar -->
            <Border Grid.Row="2" Classes="Toolbar TreeToolbar" Padding="6,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" >
                  <Button Command="{Binding OpenFileCommand}" Classes="IconBtn"
                          ToolTip.Tip="Open file" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-folder}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding SaveCommand}" Classes="IconBtn"
                          ToolTip.Tip="Save" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-save}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding OpenDiffCommand}" Classes="IconBtn"
                          ToolTip.Tip="Show diff" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-shuffle}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Command="{Binding ToggleTextModeCommand}" Classes="IconBtn"
                          ToolTip.Tip="Toggle text mode" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-code}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                  </Button>
                  <Button Command="{Binding ToggleThemeCommand}" Classes="IconBtn"
                          ToolTip.Tip="Toggle theme" Width="28" Height="28" Padding="4">
                    <Panel>
                      <Path Classes="Lucide" Data="{StaticResource lucide-moon}" Width="14" Height="14"
                                Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"
                                IsVisible="{Binding Dark}" />
                      <Path Classes="Lucide" Data="{StaticResource lucide-sun}" Width="14" Height="14"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding Dark, Converter={x:Static conv:EditorConverters.InverseBool}}" />
                    </Panel>
                  </Button>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ===== CONTENT AREA: TEXT MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding TextMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="TEXT" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding TextEditorPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="ErrorBanner" DockPanel.Dock="Top"
                    IsVisible="{Binding HasTextParseError}">
              <TextBlock Text="{Binding TextParseError}" Classes="ErrorText" />
            </Border>
            <TextBox Text="{Binding TextContent}"
                     Classes="MonoEditor" AcceptsReturn="True"
                     Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" />
            <Border Classes="HelpStrip" DockPanel.Dock="Bottom" IsVisible="{Binding EditorHelpVisible}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding EditorHelpInfo.ContextDescription}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.ContextDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <TextBlock Text="{Binding EditorHelpInfo.FieldDescription}" Classes="HelpFieldDescription"
                           IsVisible="{Binding EditorHelpInfo.FieldDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>

        <!-- ===== CONTENT AREA: OBJECT MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsObjectMode}">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Classes="PanelHeader"
                    BorderBrush="{DynamicResource PanelBorderBrush}">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
                  <TextBlock Text="OBJECT" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right">
                  <Button Classes="AddPropertyBtn" IsVisible="{Binding CanAddProperty}"
                          Click="AddProperty_Click" ToolTip.Tip="Add property"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="10" Height="10"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="Add property" FontFamily="{StaticResource FontJetBrainsMono}" FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding UndoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Lucide" Data="{StaticResource lucide-undo}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding RedoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Lucide" Data="{StaticResource lucide-redo}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:FieldRow">
                    <Border Margin="0,0,0,8" Padding="0" Background="Transparent" Classes="FieldRowDeleteHost"
                            Tapped="FieldRow_Tapped" KeyDown="FieldRow_KeyDown" Tag="{Binding Path}">
                      <Grid ColumnDefinitions="130,10,*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock Text="{Binding Key}" Classes="FieldLabel"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       DoubleTapped="FieldName_DoubleTapped"
                                       IsVisible="{Binding IsEditingName, Converter={x:Static conv:EditorConverters.InverseBool}}" />
                            <TextBox Text="{Binding EditName}" Classes="FieldNameEditor"
                                     VerticalContentAlignment="Center"
                                     IsVisible="{Binding IsEditingName}"
                                     GotFocus="FieldNameEditor_GotFocus"
                                     KeyDown="FieldNameEditor_KeyDown"
                                     LostFocus="FieldNameEditor_LostFocus" />
                          </Grid>
                          <TextBlock Text="{Binding RenameError}" Classes="RenameErrorText"
                                     IsVisible="{Binding HasRenameError}" />
                        </StackPanel>
                        <Grid Grid.Column="1" />
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                          <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=object}"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoCommand}"
                                  CommandParameter="{Binding Path}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding NestedObjectSummary}"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                              <Path Classes="Lucide" Data="{StaticResource lucide-arrow-right}" Width="10" Height="10"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                          </Button>
                          <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=array}"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoArrayCommand}"
                                  CommandParameter="{Binding Path}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Path Classes="Lucide" Data="{StaticResource array-bracket}" Width="10" Height="10"
                                        Stroke="{DynamicResource AccentBrush}" />
                              <TextBlock Text="{Binding ArrayItemCount}"
                                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                              <Path Classes="Lucide" Data="{StaticResource lucide-arrow-right}" Width="10" Height="10"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                           </Button>
                           <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.FieldTypeIsTemporal}}">
                             <views:TemporalFieldEditor />
                             <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                     IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                           </Grid>
                           <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=integer}">
                              <controls:SchemaNumericUpDown Value="{Binding NumericValue}" AllowSpin="True" ShowButtonSpinner="True"
                                             Classes="EditorNum"
                                             IsReadOnly="{Binding IsReadOnly}"
                                             ValueChanged="NumericUpDown_ValueChanged"
                                             LostFocus="NumericUpDown_LostFocus"
                                             GotFocus="NumericUpDown_GotFocus"
                                             FormatString="N0" />
                             <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                     IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                           </Grid>
                           <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=number}">
                              <controls:SchemaNumericUpDown Value="{Binding NumericValue}" AllowSpin="True" ShowButtonSpinner="True"
                                             Classes="EditorNum"
                                             IsReadOnly="{Binding IsReadOnly}"
                                             ValueChanged="NumericUpDown_ValueChanged"
                                             LostFocus="NumericUpDown_LostFocus"
                                             GotFocus="NumericUpDown_GotFocus"
                                             FormatString="N2" />
                             <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                     IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                           </Grid>
                           <CheckBox IsChecked="{Binding BoolValue}"
                                     IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                     IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=boolean}"
                                     HorizontalAlignment="Left"
                                     GotFocus="EditorField_GotFocus"
                                     IsCheckedChanged="BooleanCheckBox_IsCheckedChanged" />
                           <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=enum}">
                             <ComboBox ItemsSource="{Binding EnumValues}"
                                       SelectedItem="{Binding ScalarValue}"
                                       IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                       HorizontalAlignment="Stretch"
                                       GotFocus="EditorField_GotFocus"
                                       SelectionChanged="EnumComboBox_SelectionChanged" />
                             <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                     IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                           </Grid>
                           <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=scalar}">
                             <TextBox Text="{Binding ScalarValue}" Classes="EditorInput"
                                      IsReadOnly="{Binding IsReadOnly}"
                                      HorizontalAlignment="Stretch"
                                      GotFocus="EditorField_GotFocus"
                                      LostFocus="EditorScalar_LostFocus"
                                      KeyDown="EditorScalar_KeyDown" />
                             <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                     IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                           </Grid>
                           <TextBlock Text="null"
                                      IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=null}"
                                      Foreground="{DynamicResource TextTertiaryBrush}"
                                      FontStyle="Italic" VerticalAlignment="Center" />
                          </Grid>
                          <Button Grid.Column="3" Classes="IconBtn FieldRowDeleteBtn" Width="22" Height="22" Padding="2"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                  Click="FieldRowAction_Click"
                                  Tapped="FieldRowDelete_Tapped" ToolTip.Tip="Property actions">
                            <TextBlock Text="⋮" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Button>
                        </Grid>
                      </Border>
                   </DataTemplate>
                 </ItemsControl.ItemTemplate>
               </ItemsControl>
             </ScrollViewer>
             <Border Grid.Row="2" Classes="HelpStrip" IsVisible="{Binding EditorHelpVisible}">
              <StackPanel Spacing="4">
                <Border IsVisible="{Binding EditorHelpInfo.HasValidationErrors}">
                  <TextBlock Text="{Binding EditorHelpInfo.ErrorMessages}" Classes="ErrorText" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding EditorHelpInfo.ContextDescription}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.ContextDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.ContextMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
                <TextBlock Text="{Binding EditorHelpInfo.FieldDescription}" Classes="HelpFieldDescription"
                           IsVisible="{Binding EditorHelpInfo.FieldDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.FieldMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
                <WrapPanel>
                  <Border Classes="Badge BadgeRequired" IsVisible="{Binding EditorHelpInfo.IsRequired}">
                    <TextBlock Text="REQUIRED" Classes="BadgeText" Foreground="{DynamicResource ErrorBrush}" />
                  </Border>
                  <Border Classes="Badge BadgeWarn" IsVisible="{Binding EditorHelpInfo.IsDeprecated}">
                    <TextBlock Text="DEPRECATED" Classes="BadgeText" Foreground="{DynamicResource WarnBrush}" />
                  </Border>
                  <Border Classes="Badge BadgeMuted" IsVisible="{Binding EditorHelpInfo.IsReadOnly}">
                    <TextBlock Text="READ-ONLY" Classes="BadgeText" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding EditorHelpInfo.Comment}" Classes="HelpComment"
                           IsVisible="{Binding EditorHelpInfo.Comment, Converter={x:Static conv:EditorConverters.NullToBool}}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ===== CONTENT AREA: ARRAY SPLIT MODE ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" IsVisible="{Binding IsArrayMode}">
          <!-- Shared Breadcrumb Header -->
           <Border Grid.Row="0" Classes="PanelHeader" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
               <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">  
                  <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="AddPropertyBtn" IsVisible="{Binding CanAddProperty}"
                        Click="AddProperty_Click" ToolTip.Tip="Add property"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="10" Height="10"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Add property" FontFamily="{StaticResource FontJetBrainsMono}" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding UndoCommand}" Classes="IconBtn"
                        IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo"
                        Width="22" Height="22" Padding="2">
                  <Path Classes="Lucide" Data="{StaticResource lucide-undo}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button Command="{Binding RedoCommand}" Classes="IconBtn"
                        IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo"
                        Width="22" Height="22" Padding="2">
                  <Path Classes="Lucide" Data="{StaticResource lucide-redo}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button IsVisible="{Binding NestedCtx, Converter={x:Static conv:EditorConverters.NullToBool}}"
                        Classes="IconBtn"
                        Command="{Binding ExitNestedArrayCommand}"
                        Width="22" Height="22" Padding="2" ToolTip.Tip="zurück">
                  <Path Classes="Lucide" Data="{StaticResource lucide-arrow-left}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" ></StackPanel>
            </DockPanel>
          </Border>
          <!-- Split Content: Cards | Detail -->
          <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <!-- Card List -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardSplitBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
              <DockPanel>
                <Border Classes="HelpStripCompact" DockPanel.Dock="Top"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}"
                        Padding="6,12" IsVisible="{Binding ArrayHelpVisible}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding ArrayHelpInfo.Description}" Classes="HelpDescription"
                               IsVisible="{Binding ArrayHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                  </StackPanel>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}"
                        DockPanel.Dock="Bottom" Padding="8,12">
                  <Button Classes="DashedBtn" Command="{Binding AddCardCommand}"
                          IsEnabled="{Binding ArrayHelpInfo.IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                          HorizontalAlignment="Stretch" Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="12" Height="12"
                                Stroke="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="Hinzufügen" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                    </StackPanel>
                  </Button>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CardItems}" Margin="10,12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CardItem">
                        <Border Classes="CardItem" Margin="0,0,0,6"
                                BorderBrush="{Binding IsSelected, Converter={x:Static conv:EditorConverters.CardSelectedToBorderBrush}}"
                                Tapped="CardItem_Tapped">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                           FontFamily="{StaticResource FontJetBrainsMono}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <Path Classes="Lucide" Data="{StaticResource lucide-circle-alert}" Width="10" Height="10"
                                          Stroke="{DynamicResource ErrorBrush}"
                                          IsVisible="{Binding HasErrors}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Preview}" Classes="CardPreview" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Classes="IconBtn" Width="20" Height="20" Padding="2"
                                    IsEnabled="{Binding ElementName=RootWindow, Path=DataContext.ArrayHelpInfo.IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                    Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteCardCommand}"
                                    CommandParameter="{Binding Index}"
                                    Tapped="CardDelete_Tapped" ToolTip.Tip="Delete">
                              <Path Classes="Lucide" Data="{StaticResource lucide-trash-2}" Width="12" Height="12"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <!-- Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}">
              <Grid RowDefinitions="*,Auto">
                <Border Grid.Row="0" IsVisible="{Binding ShowEmptyDetailState}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="Kein Item ausgewählt"
                             Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11" />
                </Border>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasObjectFields}">
                  <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:FieldRow">
                        <Border Margin="0,0,0,8" Background="Transparent" Classes="FieldRowDeleteHost"
                                Tapped="FieldRow_Tapped" KeyDown="FieldRow_KeyDown" Tag="{Binding Path}">
                          <Grid ColumnDefinitions="130,10,*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <Grid>
                                <TextBlock Text="{Binding Key}" Classes="FieldLabel"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           DoubleTapped="FieldName_DoubleTapped"
                                           IsVisible="{Binding IsEditingName, Converter={x:Static conv:EditorConverters.InverseBool}}" />
                                <TextBox Text="{Binding EditName}" Classes="FieldNameEditor"
                                         VerticalContentAlignment="Center" 
                                         IsVisible="{Binding IsEditingName}"
                                         GotFocus="FieldNameEditor_GotFocus"
                                         KeyDown="FieldNameEditor_KeyDown"
                                         LostFocus="FieldNameEditor_LostFocus" />
                              </Grid>
                              <TextBlock Text="{Binding RenameError}" Classes="RenameErrorText"
                                         IsVisible="{Binding HasRenameError}" />
                            </StackPanel>
                            <Grid Grid.Column="1" />
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                              <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=object}"
                                      Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoCommand}"
                                      CommandParameter="{Binding Path}"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      BorderBrush="{DynamicResource PanelBorderBrush}"
                                      BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding NestedObjectSummary}"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                                  <Path Classes="Lucide" Data="{StaticResource lucide-arrow-right}" Width="10" Height="10"
                                            Stroke="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                              </Button>
                               <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=array}"
                                       Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoArrayCommand}"
                                       CommandParameter="{Binding Path}"
                                       Background="{DynamicResource CardBackgroundBrush}"
                                       BorderBrush="{DynamicResource PanelBorderBrush}"
                                       BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                 <StackPanel Orientation="Horizontal" Spacing="6">
                                   <Path Classes="Lucide" Data="{StaticResource array-bracket}" Width="10" Height="10"
                                             Stroke="{DynamicResource AccentBrush}" />
                                   <TextBlock Text="{Binding ArrayItemCount}"
                                              FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                                   <Path Classes="Lucide" Data="{StaticResource lucide-arrow-right}" Width="10" Height="10"
                                             Stroke="{DynamicResource TextTertiaryBrush}" />
                                 </StackPanel>
                               </Button>
                               <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.FieldTypeIsTemporal}}">
                                 <views:TemporalFieldEditor />
                                 <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                               </Grid>
                               <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=integer}">
                                  <controls:SchemaNumericUpDown Value="{Binding NumericValue}" AllowSpin="True" ShowButtonSpinner="True"
                                                 Classes="EditorNum"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 ValueChanged="NumericUpDown_ValueChanged"
                                                 LostFocus="NumericUpDown_LostFocus"
                                                 GotFocus="NumericUpDown_GotFocus"
                                                 FormatString="N0" />
                                 <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                               </Grid>
                               <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=number}">
                                  <controls:SchemaNumericUpDown Value="{Binding NumericValue}" AllowSpin="True" ShowButtonSpinner="True"
                                                 Classes="EditorNum"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 ValueChanged="NumericUpDown_ValueChanged"
                                                 LostFocus="NumericUpDown_LostFocus"
                                                 GotFocus="NumericUpDown_GotFocus"
                                                 FormatString="N2" />
                                 <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                               </Grid>
                               <CheckBox IsChecked="{Binding BoolValue}"
                                         IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                         IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=boolean}"
                                         HorizontalAlignment="Left"
                                         GotFocus="EditorField_GotFocus"
                                         IsCheckedChanged="BooleanCheckBox_IsCheckedChanged" />
                               <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=enum}">
                                 <ComboBox ItemsSource="{Binding EnumValues}"
                                           SelectedItem="{Binding ScalarValue}"
                                           IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                           HorizontalAlignment="Stretch"
                                           GotFocus="EditorField_GotFocus"
                                           SelectionChanged="EnumComboBox_SelectionChanged" />
                                 <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                               </Grid>
                               <Grid IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=scalar}">
                                 <TextBox Text="{Binding ScalarValue}" Classes="EditorInput"
                                          IsReadOnly="{Binding IsReadOnly}"
                                          HorizontalAlignment="Stretch"
                                          GotFocus="EditorField_GotFocus"
                                          LostFocus="EditorScalar_LostFocus"
                                          KeyDown="EditorScalar_KeyDown" />
                                 <Border BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasErrors}" IsHitTestVisible="False" />
                               </Grid>
                               <TextBlock Text="null"
                                          IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=null}"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          FontStyle="Italic" VerticalAlignment="Center" />
                             </Grid>
                             <Button Grid.Column="3" Classes="IconBtn FieldRowDeleteBtn" Width="22" Height="22" Padding="2"
                                     VerticalAlignment="Center"
                                     IsEnabled="{Binding IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                     Click="FieldRowAction_Click"
                                     Tapped="FieldRowDelete_Tapped" ToolTip.Tip="Property actions">
                               <TextBlock Text="⋮" FontSize="15" FontWeight="Bold"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                             </Button>
                           </Grid>
                         </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasScalarDetail}">
                  <DockPanel>
                    <Border Classes="PanelHeader" DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource PanelBorderBrush}" Padding="14,0">
                      <TextBlock Text="VALUE" Classes="HeaderLabel"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="8" Margin="12,14" VerticalAlignment="Top">
                      <TextBlock Text="Value" Classes="FieldLabel" />
                      <TextBox x:Name="ScalarDetailTextBox" Text="{Binding DetailScalarText}" Classes="EditorInput" HorizontalAlignment="Stretch"
                               GotFocus="ScalarDetail_GotFocus" KeyDown="ScalarDetail_KeyDown"
                               LostFocus="ScalarDetail_LostFocus" />
                    </StackPanel>
                  </DockPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Classes="HelpStrip HelpStripCompact" IsVisible="{Binding EditorHelpVisible}">
                  <StackPanel Spacing="3">
                    <Border IsVisible="{Binding EditorHelpInfo.HasValidationErrors}">
                      <TextBlock Text="{Binding EditorHelpInfo.ErrorMessages}" Classes="ErrorText" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding EditorHelpInfo.ContextDescription}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.ContextDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.ContextMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
                <TextBlock Text="{Binding EditorHelpInfo.FieldDescription}" Classes="HelpFieldDescription"
                           IsVisible="{Binding EditorHelpInfo.FieldDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.FieldMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
                <WrapPanel>
                  <Border Classes="Badge BadgeRequired" IsVisible="{Binding EditorHelpInfo.IsRequired}">
                    <TextBlock Text="REQUIRED" Classes="BadgeText" Foreground="{DynamicResource ErrorBrush}" />
                  </Border>
                  <Border Classes="Badge BadgeWarn" IsVisible="{Binding EditorHelpInfo.IsDeprecated}">
                    <TextBlock Text="DEPRECATED" Classes="BadgeText" Foreground="{DynamicResource WarnBrush}" />
                  </Border>
                  <Border Classes="Badge BadgeMuted" IsVisible="{Binding EditorHelpInfo.IsReadOnly}">
                    <TextBlock Text="READ-ONLY" Classes="BadgeText" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding EditorHelpInfo.Comment}" Classes="HelpComment"
                           IsVisible="{Binding EditorHelpInfo.Comment, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== CONTENT AREA: SCALAR MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsScalarMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="VALUE" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding SelectedPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="12,14" VerticalAlignment="Top">
                <TextBox Text="{Binding ScalarNode.Label}"
                         Classes="EditorInput" Width="300" />
              </Grid>
            </ScrollViewer>
            <Border Classes="HelpStrip" DockPanel.Dock="Bottom" IsVisible="{Binding EditorHelpVisible}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding EditorHelpInfo.ContextDescription}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.ContextDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.ContextMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
                <TextBlock Text="{Binding EditorHelpInfo.FieldDescription}" Classes="HelpFieldDescription"
                           IsVisible="{Binding EditorHelpInfo.FieldDescription, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <ItemsControl ItemsSource="{Binding EditorHelpInfo.FieldMetaItems}"
                              ItemsPanel="{StaticResource MetaItemsPanel}"
                              ItemTemplate="{StaticResource MetaItemTemplate}" />
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>

      </Grid>
    </DockPanel>

    <!-- ===== DIFF MODAL OVERLAY ===== -->
    <Border IsVisible="{Binding ShowDiff}" Classes="DiffOverlay" Tapped="DiffOverlay_Tapped">
      <Border Classes="DiffPanel" Width="800" Height="600"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border Classes="PanelHeader" DockPanel.Dock="Top">
            <DockPanel VerticalAlignment="Center">
              <TextBlock Text="DIFF — original vs. current" Classes="HeaderLabel" />
              <Button DockPanel.Dock="Right" Classes="IconBtn"
                      Command="{Binding CloseDiffCommand}" Width="22" Height="22" Padding="2">
                <Path Classes="Lucide" Data="{StaticResource lucide-x}" Width="12" Height="12"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
              </Button>
            </DockPanel>
          </Border>
          <views:DiffView DataContext="{Binding Diff}" />
        </DockPanel>
      </Border>
    </Border>

  </Panel>

</Window>
