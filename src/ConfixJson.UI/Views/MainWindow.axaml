<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConfixJson.UI.ViewModels"
        xmlns:models="using:ConfixJson.Core.Models"
        xmlns:services="using:ConfixJson.Core.Services"
        xmlns:conv="clr-namespace:ConfixJson.UI.Converters"
        xmlns:views="using:ConfixJson.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ConfixJson.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="{Binding DocumentFilename}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>

    <!-- Icons -->
    <StreamGeometry x:Key="feather-folder">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z</StreamGeometry>
    <StreamGeometry x:Key="feather-moon">M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z</StreamGeometry>
    <StreamGeometry x:Key="feather-sun">M12 1v2m0 18v2M4.22 4.22l1.42 1.42m11.3 11.3 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42M12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12z</StreamGeometry>
    <StreamGeometry x:Key="feather-code">M16 18l6-6-6-6M8 6l-6 6 6 6</StreamGeometry>
    <StreamGeometry x:Key="feather-save">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m4-5 5 5 5-5m-5 5V3</StreamGeometry>
    <StreamGeometry x:Key="feather-menu">M3 12h18M3 6h18M3 18h18</StreamGeometry>
    <StreamGeometry x:Key="feather-chevron-right">M9 18l6-6-6-6</StreamGeometry>
    <StreamGeometry x:Key="feather-chevron-down">M6 9l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="feather-bracket">M3,3 L3,11 M3,3 L5,3 M3,11 L5,11 M11,3 L11,11 M9,3 L11,3 M9,11 L11,11</StreamGeometry>
    <StreamGeometry x:Key="feather-alert-circle">M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 8v4M12 16h.01</StreamGeometry>
    <StreamGeometry x:Key="feather-trash-2">M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
    <StreamGeometry x:Key="feather-plus">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="feather-arrow-right">M5 12h14m-7-7 7 7-7 7</StreamGeometry>
    <StreamGeometry x:Key="feather-arrow-left">M19 12H5m7 7-7-7 7-7</StreamGeometry>
    <StreamGeometry x:Key="feather-x">M18 6 6 18M6 6l12 12</StreamGeometry>

  </Window.Resources>

  <Panel>

    <!-- ===== MAIN LAYOUT ===== -->
    <DockPanel>

      <!-- ===== TOP HEADER ===== -->
      <Border Classes="Toolbar TopHeader" DockPanel.Dock="Top" Padding="14,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left">
            <TextBlock Text="JSON EDITOR" Classes="HeaderLabel" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DocumentFilename}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <Border Classes="StatusError" IsVisible="{Binding HasErrors}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} errors}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="9" FontWeight="Bold" />
          </Border>
          <Border Classes="StatusSuccess" IsVisible="{Binding ShowSaved}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="saved" Foreground="{DynamicResource AccentBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="9" FontWeight="Bold" />
            </Border>
          </DockPanel>
        </Border>

      <!-- ===== BODY ===== -->
      <Grid ColumnDefinitions="240,*">
        <!-- ===== TREE PANEL ===== -->
         <Border Grid.Column="0" BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource AccentBrush}"
                Background="{DynamicResource TreeBackgroundBrush}">
          <Grid RowDefinitions="Auto,*,Auto">
            <!-- Tree Search -->
            <TextBox Grid.Row="0" PlaceholderText="Filter..." 
                     FontFamily="{StaticResource FontJetBrainsMono}"
                     FontSize="11" Padding="6,4"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderBrush="{DynamicResource PanelBorderBrush}"
                     BorderThickness="0,0,0,1"
                     Margin="0" />
            <!-- Tree Scroll Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding TreeRootNodes}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <views:TreeDataTemplate />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Tree Toolbar -->
            <Border Grid.Row="2" Classes="Toolbar TreeToolbar" Padding="6,0">
              <StackPanel Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding OpenFileCommand}" Classes="IconBtn"
                        ToolTip.Tip="Open file" Width="28" Height="28" Padding="4">
                  <Path Classes="Feather" Data="{StaticResource feather-folder}" Width="14" Height="14"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button Command="{Binding ToggleThemeCommand}" Classes="IconBtn"
                        ToolTip.Tip="Toggle theme" Width="28" Height="28" Padding="4">
                  <Panel>
                    <Path Classes="Feather" Data="{StaticResource feather-moon}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              IsVisible="{Binding Dark}" />
                    <Path Classes="Feather" Data="{StaticResource feather-sun}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              IsVisible="{Binding Dark, Converter={x:Static conv:EditorConverters.InverseBool}}" />
                  </Panel>
                </Button>
                <Button Command="{Binding ToggleTextModeCommand}" Classes="IconBtn"
                        ToolTip.Tip="Toggle text mode" Width="28" Height="28" Padding="4">
                  <Path Classes="Feather" Data="{StaticResource feather-code}" Width="14" Height="14"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button Command="{Binding SaveCommand}" Classes="IconBtn"
                        ToolTip.Tip="Save" Width="28" Height="28" Padding="4">
                  <Path Classes="Feather" Data="{StaticResource feather-save}" Width="14" Height="14"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button Command="{Binding OpenDiffCommand}" Classes="IconBtn"
                        ToolTip.Tip="Show diff" Width="28" Height="28" Padding="4">
                  <Path Classes="Feather" Data="{StaticResource feather-menu}" Width="14" Height="14"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ===== CONTENT AREA: TEXT MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding TextMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="TEXT" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding TextEditorPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="ErrorBanner" DockPanel.Dock="Top"
                    IsVisible="{Binding HasTextParseError}">
              <TextBlock Text="{Binding TextParseError}" Classes="ErrorText" />
            </Border>
            <TextBox Text="{Binding TextContent}"
                     Classes="MonoEditor" AcceptsReturn="True"
                     Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" />
            <Border Classes="HelpStrip" DockPanel.Dock="Bottom">
              <StackPanel Spacing="3">
                <TextBlock Text="Schema-Hilfe"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontStyle="Italic" FontSize="11"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <TextBlock Text="{Binding EditorHelpInfo.Description}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>

        <!-- ===== CONTENT AREA: OBJECT MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsObjectMode}">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Classes="PanelHeader"
                    BorderBrush="{DynamicResource PanelBorderBrush}">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="OBJECT" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right">
                  <Button Command="{Binding UndoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Feather" Data="{StaticResource feather-arrow-left}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding RedoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Feather" Data="{StaticResource feather-arrow-right}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:FieldRow">
                    <Border Margin="0,0,0,8" Padding="0"
                            Tapped="FieldRow_Tapped" Tag="{Binding Path}">
                      <Grid ColumnDefinitions="130,10,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <DockPanel>
                            <TextBlock Text="*" Foreground="{DynamicResource ErrorBrush}"
                                       FontWeight="Bold" Margin="0,0,2,0"
                                       IsVisible="{Binding IsRequired}" DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding Key}" Classes="FieldLabel"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" />
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                          <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=object}"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoCommand}"
                                  CommandParameter="{Binding Path}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding NestedObjectSummary}"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                              <Path Classes="Feather" Data="{StaticResource feather-arrow-right}" Width="10" Height="10"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                          </Button>
                          <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=array}"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoArrayCommand}"
                                  CommandParameter="{Binding Path}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Path Classes="Feather" Data="{StaticResource feather-bracket}" Width="10" Height="10"
                                        Stroke="{DynamicResource AccentBrush}" />
                              <TextBlock Text="{Binding ArrayItemCount}"
                                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                              <Path Classes="Feather" Data="{StaticResource feather-arrow-right}" Width="10" Height="10"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                          </Button>
                          <TextBox Text="{Binding ScalarValue}" Classes="EditorInput"
                                   IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=scalar}"
                                   Width="250" HorizontalAlignment="Left" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Classes="HelpStrip">
              <StackPanel Spacing="4">
                <Border IsVisible="{Binding EditorHelpInfo.HasValidationErrors}">
                  <TextBlock Text="{Binding EditorHelpInfo.ErrorMessages}" Classes="ErrorText" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Schema-Hilfe"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <TextBlock Text="{Binding EditorHelpInfo.Description}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <WrapPanel>
                  <Border Classes="Badge BadgeWarn" IsVisible="{Binding EditorHelpInfo.IsDeprecated}">
                    <TextBlock Text="DEPRECATED" Classes="BadgeText" Foreground="{DynamicResource WarnBrush}" />
                  </Border>
                  <Border Classes="Badge BadgeMuted" IsVisible="{Binding EditorHelpInfo.IsReadOnly}">
                    <TextBlock Text="READ-ONLY" Classes="BadgeText" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                  <TextBlock Text="{Binding EditorHelpInfo.Comment}" Classes="HelpComment"
                             IsVisible="{Binding EditorHelpInfo.Comment, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ===== CONTENT AREA: ARRAY SPLIT MODE ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" IsVisible="{Binding IsArrayMode}">
          <!-- Shared Breadcrumb Header -->
           <Border Grid.Row="0" Classes="PanelHeader" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle"
                         VerticalAlignment="Center" />
              <Button IsVisible="{Binding NestedCtx, Converter={x:Static conv:EditorConverters.NullToBool}}"
                      DockPanel.Dock="Right" Classes="IconBtn"
                      Command="{Binding ExitNestedArrayCommand}"
                      Width="22" Height="22" Padding="2" ToolTip.Tip="zurück">
                <Path Classes="Feather" Data="{StaticResource feather-arrow-left}" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
              </Button>
            </DockPanel>
          </Border>
          <!-- Split Content: Cards | Detail -->
          <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <!-- Card List -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardSplitBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
              <DockPanel>
                <Border Classes="HelpStripCompact" DockPanel.Dock="Top"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}"
                        Padding="6,12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Schema-Hilfe"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11"
                               IsVisible="{Binding ArrayHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                    <TextBlock Text="{Binding ArrayHelpInfo.Description}" Classes="HelpDescription"
                               IsVisible="{Binding ArrayHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                  </StackPanel>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}"
                        DockPanel.Dock="Bottom" Padding="8,12">
                  <Button Classes="DashedBtn" Command="{Binding AddCardCommand}"
                          HorizontalAlignment="Stretch" Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <Path Classes="Feather" Data="{StaticResource feather-plus}" Width="12" Height="12"
                                Stroke="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="Hinzufügen"
                                 FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                    </StackPanel>
                  </Button>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CardItems}" Margin="10,12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CardItem">
                        <Border Classes="CardItem" Margin="0,0,0,6"
                                Tapped="CardItem_Tapped">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                           FontFamily="{StaticResource FontJetBrainsMono}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <Path Classes="Feather" Data="{StaticResource feather-alert-circle}" Width="10" Height="10"
                                          Stroke="{DynamicResource ErrorBrush}"
                                          IsVisible="{Binding HasErrors}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Preview}" Classes="CardPreview" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Classes="IconBtn" Width="20" Height="20" Padding="2"
                                    Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteCardCommand}"
                                    CommandParameter="{Binding Index}"
                                    Tapped="CardDelete_Tapped" ToolTip.Tip="Delete">
                              <Path Classes="Feather" Data="{StaticResource feather-trash-2}" Width="12" Height="12"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <!-- Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}">
              <Grid RowDefinitions="*,Auto">
                <Border Grid.Row="0" IsVisible="{Binding ShowEmptyDetailState}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="Kein Item ausgewählt"
                             Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11" />
                </Border>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasObjectFields}">
                  <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:FieldRow">
                        <Border Margin="0,0,0,8" Tapped="FieldRow_Tapped" Tag="{Binding Path}">
                          <Grid ColumnDefinitions="130,10,*">
                            <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="FieldLabel"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Column="1" />
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                              <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=object}"
                                      Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoCommand}"
                                      CommandParameter="{Binding Path}"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      BorderBrush="{DynamicResource PanelBorderBrush}"
                                      BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding NestedObjectSummary}"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                                  <Path Classes="Feather" Data="{StaticResource feather-arrow-right}" Width="10" Height="10"
                                            Stroke="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                              </Button>
                              <Button IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=array}"
                                      Command="{Binding ElementName=RootWindow, Path=DataContext.DrillIntoArrayCommand}"
                                      CommandParameter="{Binding Path}"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      BorderBrush="{DynamicResource PanelBorderBrush}"
                                      BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Path Classes="Feather" Data="{StaticResource feather-bracket}" Width="10" Height="10"
                                            Stroke="{DynamicResource AccentBrush}" />
                                  <TextBlock Text="{Binding ArrayItemCount}"
                                             FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                                  <Path Classes="Feather" Data="{StaticResource feather-arrow-right}" Width="10" Height="10"
                                            Stroke="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                              </Button>
                              <TextBox Text="{Binding ScalarValue}" Classes="EditorInput"
                                       IsVisible="{Binding FieldType, Converter={x:Static conv:EditorConverters.EditorModeToBool}, ConverterParameter=scalar}"
                                       Width="250" HorizontalAlignment="Left" />
                            </Grid>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasScalarDetail}">
                  <DockPanel>
                    <Border Classes="PanelHeader" DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource PanelBorderBrush}" Padding="14,0">
                      <TextBlock Text="VALUE" Classes="HeaderLabel"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="8" Margin="12,14" VerticalAlignment="Top">
                      <TextBlock Text="Value" Classes="FieldLabel" />
                      <TextBox Text="{Binding DetailScalarText}" Classes="EditorInput" Width="300" HorizontalAlignment="Left" />
                    </StackPanel>
                  </DockPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Classes="HelpStrip HelpStripCompact">
                  <StackPanel Spacing="3">
                    <Border IsVisible="{Binding EditorHelpInfo.HasValidationErrors}">
                      <TextBlock Text="{Binding EditorHelpInfo.ErrorMessages}" Classes="ErrorText" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="Schema-Hilfe"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11"
                               IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                    <TextBlock Text="{Binding EditorHelpInfo.Description}" Classes="HelpDescription"
                               IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== CONTENT AREA: SCALAR MODE ===== -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsScalarMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="VALUE" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding SelectedPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="12,14" VerticalAlignment="Top">
                <TextBox Text="{Binding ScalarNode.Label}"
                         Classes="EditorInput" Width="300" />
              </Grid>
            </ScrollViewer>
            <Border Classes="HelpStrip" DockPanel.Dock="Bottom">
              <WrapPanel>
                <TextBlock Text="Schema-Hilfe"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11"
                           Margin="0,0,12,0"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                <TextBlock Text="{Binding EditorHelpInfo.Description}" Classes="HelpDescription"
                           IsVisible="{Binding EditorHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
              </WrapPanel>
            </Border>
          </DockPanel>
        </Border>

      </Grid>
    </DockPanel>

    <!-- ===== DIFF MODAL OVERLAY ===== -->
    <Border IsVisible="{Binding ShowDiff}" Classes="DiffOverlay" Tapped="DiffOverlay_Tapped">
      <Border Classes="DiffPanel" Width="800" Height="600"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border Classes="PanelHeader" DockPanel.Dock="Top">
            <DockPanel VerticalAlignment="Center">
              <TextBlock Text="DIFF — original vs. current" Classes="HeaderLabel" />
              <Button DockPanel.Dock="Right" Classes="IconBtn"
                      Command="{Binding CloseDiffCommand}" Width="22" Height="22" Padding="2">
                <Path Classes="Feather" Data="{StaticResource feather-x}" Width="12" Height="12"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
              </Button>
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiffLines}" Margin="0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:JsonDiffLine">
                  <Border Background="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToBackground}}"
                          Padding="8,1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToMarker}}"
                                 Width="12"
                                 FontFamily="{StaticResource FontJetBrainsMono}"
                                 FontSize="11" FontWeight="Bold"
                                 Foreground="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToMarkerColor}}" />
                      <TextBlock Text="{Binding Text}"
                                 FontFamily="{StaticResource FontJetBrainsMono}" FontSize="11" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

  </Panel>

</Window>
