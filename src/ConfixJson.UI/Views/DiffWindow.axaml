<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConfixJson.UI.ViewModels"
        xmlns:views="using:ConfixJson.UI.Views"
        x:Class="ConfixJson.UI.Views.DiffWindow"
        x:DataType="vm:DiffViewModel"
        Title="Diff"
        Width="900" Height="700"
        MinWidth="500" MinHeight="400"
        Background="{DynamicResource BackgroundBrush}">

  <DockPanel>
    <Border Classes="PanelHeader" DockPanel.Dock="Top">
      <DockPanel VerticalAlignment="Center">
        <TextBlock Text="DIFF" Classes="HeaderLabel" />
        <Button DockPanel.Dock="Right" Classes="IconBtn"
                Click="Close_Click" Width="22" Height="22" Padding="2" ToolTip.Tip="Close">
          <Path Classes="Lucide" Data="{StaticResource lucide-x}" Width="12" Height="12"
                Stroke="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </DockPanel>
    </Border>

    <TextBlock Text="{Binding ErrorMessage}" Classes="ErrorText" Margin="12" TextWrapping="Wrap"
               IsVisible="{Binding HasError}" />

    <views:DiffView />
  </DockPanel>
</Window>
