<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConfixJson.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- ===== DARK ===== -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BackgroundBrush" Color="#0a0a0a" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#111111" />
          <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#0d0d0d" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#181818" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161616" />
          <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#0d0d0d" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#e8e8e8" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#555555" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#2a2a2a" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#444444" />
          <SolidColorBrush x:Key="AccentBrush" Color="#00ffee" />
          <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#001a18" />
          <SolidColorBrush x:Key="AccentDimBrush" Color="#0a2a28" />
          <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#001a18" />
          <SolidColorBrush x:Key="SelectedBorderBrush" Color="#00ffee" />
          <SolidColorBrush x:Key="TreeHoverBrush" Color="#1a1a1a" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#ff4422" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#1a0500" />
          <SolidColorBrush x:Key="ErrorDimBrush" Color="#1a0804" />
          <SolidColorBrush x:Key="WarnBrush" Color="#ffaa00" />
          <SolidColorBrush x:Key="WarnSoftBrush" Color="#1a1200" />
          <SolidColorBrush x:Key="ScrollbarBrush" Color="#2a2a2a" />
          <SolidColorBrush x:Key="MutedBackgroundBrush" Color="#1a1a1a" />
        </ResourceDictionary>
        <!-- ===== LIGHT ===== -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BackgroundBrush" Color="#f5f5f5" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#fafafa" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#f0f0f0" />
          <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#e8e8e8" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111111" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#888888" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#cccccc" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#888888" />
          <SolidColorBrush x:Key="AccentBrush" Color="#0066ff" />
          <SolidColorBrush x:Key="AccentForegroundBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#e6f0ff" />
          <SolidColorBrush x:Key="AccentDimBrush" Color="#e6f0ff" />
          <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#e6f0ff" />
          <SolidColorBrush x:Key="SelectedBorderBrush" Color="#0066ff" />
          <SolidColorBrush x:Key="TreeHoverBrush" Color="#f0f0f0" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#cc2200" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#fff0ee" />
          <SolidColorBrush x:Key="ErrorDimBrush" Color="#fff0ee" />
          <SolidColorBrush x:Key="WarnBrush" Color="#aa5500" />
          <SolidColorBrush x:Key="WarnSoftBrush" Color="#fff4e6" />
          <SolidColorBrush x:Key="ScrollbarBrush" Color="#cccccc" />
          <SolidColorBrush x:Key="MutedBackgroundBrush" Color="#e8e8e8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Fonts -->
      <FontFamily x:Key="FontJetBrainsMono">avares://ConfixJson.UI/Assets/Fonts/JetBrainsMono/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
      <FontFamily x:Key="FontInter">avares://ConfixJson.UI/Assets/Fonts/Inter/Inter-Regular.otf#Inter</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ConfixJson.UI/Styles/EditorStyles.axaml" />
  </Application.Styles>
</Application>
