<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:Jsonsui.Core.Models">

  <!-- Help meta constraint items -->
  <ItemsPanelTemplate x:Key="MetaItemsPanel">
    <WrapPanel />
  </ItemsPanelTemplate>

  <DataTemplate x:Key="MetaItemTemplate" x:DataType="models:MetaItem">
    <DockPanel Margin="0,0,14,0">
      <TextBlock DockPanel.Dock="Left" Margin="0,0,3,0" Text="{Binding Label, StringFormat={}{0}:}" Classes="HelpMetaLabel" />
      <TextBlock Text="{Binding Value}" Classes="HelpMetaValue" />
    </DockPanel>
  </DataTemplate>

</ResourceDictionary>
