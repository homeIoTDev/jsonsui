{
  "$schema":"./test_min.schema.json",
  "project": {
    "name": "Jsonsui Test Project",
    "version": "2.4.1",
    "environment": "development",
    "debug": false,
    "tags": [
      "test",
      "editor",
      "integration"
    ]
  },
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "timeout": 30,
    "maxConnections": 100,
    "tls": false
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "jsonsui",
    "ssl": true,
    "poolSize": 10,
    "queryTimeout": 3000
  },
  "auth": {
    "provider": "oidc",
    "clientId": "jsonsui-client",
    "tokenExpiry": 3600,
    "refreshEnabled": true
  },
  "plugins": [
    {
      "name": "rate-limiter",
      "enabled": true,
      "requests": 100,
      "window": 60
    },
    {
      "name": "request-logger",
      "enabled": true,
      "requests": 500,
      "window": 60
    },
    {
      "name": "security-headers",
      "enabled": false,
      "requests": 0,
      "window": 120
    }
  ],
  "logging": {
    "level": "info",
    "format": "json",
    "prettyPrint": false,
    "maxFiles": 7,
    "outputs": [
      "console",
      "file"
    ]
  }
}