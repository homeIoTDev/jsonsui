<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jsonsui.UI.ViewModels"
             xmlns:services="using:Jsonsui.Core.Services"
             xmlns:conv="clr-namespace:Jsonsui.UI.Converters"
             x:Class="Jsonsui.UI.Views.DiffView"
             x:DataType="vm:DiffViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding DiffLines}" Margin="0,4">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:JsonDiffLine">
          <Border Background="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToBackground}}"
                  Padding="8,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToMarker}}"
                         Width="12"
                         FontFamily="{StaticResource FontJetBrainsMono}"
                         FontSize="{DynamicResource EditorFontSizeBase}" FontWeight="Bold"
                         Foreground="{Binding Type, Converter={x:Static conv:EditorConverters.DiffLineTypeToMarkerColor}}" />
              <TextBlock Text="{Binding Text}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeBase}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
