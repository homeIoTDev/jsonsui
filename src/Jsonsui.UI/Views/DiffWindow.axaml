<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jsonsui.UI.ViewModels"
        xmlns:views="using:Jsonsui.UI.Views"
        x:Class="Jsonsui.UI.Views.DiffWindow"
        x:DataType="vm:DiffViewModel"
        Title="JSON Diff"
        Width="1100" Height="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

  <DockPanel>
    <Border Classes="PanelHeader" DockPanel.Dock="Top">
      <DockPanel VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Classes="IconBtn"
                Click="Close_Click" Width="22" Height="22" Padding="2" ToolTip.Tip="Close">
          <Path Classes="Lucide" Data="{StaticResource lucide-x}" Width="12" Height="12"
                Stroke="{DynamicResource TextSecondaryBrush}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="JSON Diff" Classes="HeaderLabel" />
          <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource EditorFontSizeBase}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Text="{Binding ErrorMessage}" Classes="ErrorText" Margin="12" TextWrapping="Wrap"
               IsVisible="{Binding HasError}" />

    <views:DiffView />
  </DockPanel>
</Window>
