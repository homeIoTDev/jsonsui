<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jsonsui.UI.ViewModels"
        xmlns:models="using:Jsonsui.Core.Models"
        xmlns:conv="clr-namespace:Jsonsui.UI.Converters"
        xmlns:views="using:Jsonsui.UI.Views"
        xmlns:loc="using:Jsonsui.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Jsonsui.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="{Binding DocumentFilename}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Icon="/Assets/app-icon.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource BackgroundBrush}">

  <Panel>

    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">

    <!-- ===== MAIN LAYOUT ===== -->
    <DockPanel>

      <!-- ===== TOP HEADER (eigene Titelzeile) ===== -->
      <Border x:Name="TopHeaderBar" Classes="Toolbar TopHeader" DockPanel.Dock="Top" Padding="0">
        <DockPanel VerticalAlignment="Stretch" LastChildFill="False">
          <!-- Fensterbuttons (rechts außen) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button Theme="{StaticResource CaptionButtonTheme}" Click="Minimize_Click" ToolTip.Tip="{loc:Localize Window_Minimize}">
              <Path Classes="CaptionIcon" Data="{StaticResource TitleBarMinIcon}" Width="10" Height="10"
                    Fill="{DynamicResource TextPrimaryBrush}" Stroke="Transparent" />
            </Button>
            <Button Theme="{StaticResource CaptionButtonTheme}" Click="Maximize_Click" ToolTip.Tip="{loc:Localize Window_Maximize}">
              <Path Classes="CaptionIcon" Data="{StaticResource TitleBarMaxIcon}" Width="10" Height="10" />
            </Button>
            <Button Theme="{StaticResource CaptionButtonTheme}" Classes="CaptionClose" Click="Close_Click" ToolTip.Tip="{loc:Localize Window_Close}">
              <Path Classes="CaptionIcon" Data="{StaticResource lucide-x}" Width="10" Height="10" />
            </Button>
          </StackPanel>
          <!-- Status (links von den Buttons) -->
          <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsSchemaStatusVisible}">
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaLoaded}">
              <TextBlock Text="{loc:Localize Schema_Status_Loaded}" Foreground="{DynamicResource AccentBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeSmall}" FontWeight="Bold" />
            </Button>
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaNone}">
              <TextBlock Text="{loc:Localize Schema_Status_None}" Foreground="{DynamicResource WarnBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeSmall}" FontWeight="Bold" />
            </Button>
            <Button Classes="SchemaStatus" Command="{Binding LoadSchemaCommand}"
                    ToolTip.Tip="{Binding SchemaTooltip}"
                    IsVisible="{Binding IsSchemaFailed}">
              <TextBlock Text="{loc:Localize Schema_Status_Error}" Foreground="{DynamicResource ErrorBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeSmall}" FontWeight="Bold" />
            </Button>
          </StackPanel>
          <Button Classes="StatusError" IsVisible="{Binding HasErrors}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                  Click="ErrorBadge_Click" ToolTip.Tip="{loc:Localize Errors_Tooltip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding ErrorCount, Converter={x:Static conv:EditorConverters.ErrorCountToText}}"
                         Foreground="{DynamicResource ErrorBrush}"
                         FontFamily="{StaticResource FontJetBrainsMono}"
                         FontSize="{DynamicResource EditorFontSizeTiny}" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Border Classes="StatusSuccess" IsVisible="{Binding ShowSaved}"
                  DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize Status_Saved}" Foreground="{DynamicResource AccentBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="{DynamicResource EditorFontSizeTiny}" FontWeight="Bold" />
          </Border>
          <!-- Links: App-Icon + App-Name + Dateiname -->
          <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Left"
                      Margin="5,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/app-icon.png" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock Classes="HeaderLabel" VerticalAlignment="Center">
              <Run Text="jsonsui – " /><Run Text="{loc:Localize App_Subtitle}" />
            </TextBlock>
            <TextBlock Text="{Binding DocumentFilename}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontFamily="{StaticResource FontJetBrainsMono}"
                       FontSize="{DynamicResource EditorFontSizeBase}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

        <Border Classes="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasLoadError}">
          <TextBlock Text="{Binding LoadError}" Classes="ErrorText" TextWrapping="Wrap" />
        </Border>

      <!-- ===== BODY ===== -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" MinWidth="150" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <!-- ===== TREE PANEL ===== -->
         <Border x:Name="TreePanel" Grid.Column="0"
                Background="{DynamicResource TreeBackgroundBrush}">
          <Grid RowDefinitions="Auto,*,Auto">
            <!-- Tree Search -->
            <TextBox Grid.Row="0" PlaceholderText="{loc:Localize Tree_FilterPlaceholder}" 
                     x:Name="FilterBox"
                     Text="{Binding FilterText}"
                     Classes="clearButton"
                     KeyDown="FilterBox_KeyDown"
                     VerticalContentAlignment="Center"
                     FontFamily="{StaticResource FontJetBrainsMono}"
                     FontSize="{DynamicResource EditorFontSizeBase}" Padding="6,4"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderBrush="{DynamicResource PanelBorderBrush}"
                     BorderThickness="0,0,0,1"
                     Margin="0" />
            <!-- Tree Scroll Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
              <ItemsControl x:Name="TreeItems" ItemsSource="{Binding TreeRootNodes}" Margin="0,4,0,0"
                            Focusable="True" IsTabStop="True"
                            GotFocus="Tree_GotFocus" KeyDown="Tree_KeyDown">
                <ItemsControl.ItemTemplate>
                  <views:TreeDataTemplate />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Tree Toolbar -->
            <Border Grid.Row="2" Classes="Toolbar TreeToolbar" Padding="6,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" >
                  <Button x:Name="OpenFileButton" Command="{Binding OpenFileCommand}" Classes="IconBtn"
                          ToolTip.Tip="{loc:Localize Toolbar_OpenFile}" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-folder}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding SaveCommand}" Classes="IconBtn"
                          ToolTip.Tip="{loc:Localize Toolbar_Save}" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-save}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding OpenDiffCommand}" Classes="IconBtn"
                          ToolTip.Tip="{loc:Localize Toolbar_ShowDiff}" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-shuffle}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Command="{Binding ToggleTextModeCommand}" Classes="IconBtn"
                          ToolTip.Tip="{loc:Localize Toolbar_ToggleTextMode}" Width="28" Height="28" Padding="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-code}" Width="14" Height="14"
                              Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                  </Button>
                  <Button Command="{Binding ToggleThemeCommand}" Classes="IconBtn"
                          ToolTip.Tip="{loc:Localize Toolbar_ToggleTheme}" Width="28" Height="28" Padding="4">
                    <Panel>
                      <Path Classes="Lucide" Data="{StaticResource lucide-moon}" Width="14" Height="14"
                                Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"
                                IsVisible="{Binding Dark}" />
                      <Path Classes="Lucide" Data="{StaticResource lucide-sun}" Width="14" Height="14"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding Dark, Converter={x:Static conv:EditorConverters.InverseBool}}" />
                    </Panel>
                  </Button>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Theme="{StaticResource PanelSplitterTheme}"
                      BorderBrush="{DynamicResource AccentBrush}" />

        <!-- ===== CONTENT AREA: TEXT MODE ===== -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding TextMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="JSON" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding TextEditorPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <views:HelpStripView DockPanel.Dock="Bottom" IsVisible="{Binding EditorHelpVisible}" />
            <Border Classes="StatusBar" DockPanel.Dock="Bottom">
              <TextBlock Text="{Binding TextParseError}" Classes="ErrorText"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" ToolTip.Tip="{Binding TextParseError}" />
            </Border>
            <TextBox x:Name="TextEditorBox" Text="{Binding TextContent, Mode=TwoWay}"
                     Classes="MonoEditor" AcceptsReturn="True"
                     Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" />
          </DockPanel>
        </Border>

        <!-- ===== CONTENT AREA: OBJECT MODE ===== -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsObjectMode}">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Classes="PanelHeader"
                    BorderBrush="{DynamicResource PanelBorderBrush}">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
                  <TextBlock Text="Object" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle" />
                  <Button IsVisible="{Binding NestedCtx, Converter={x:Static conv:EditorConverters.NullToBool}}"
                          Classes="IconBtn"
                          Command="{Binding ExitNestedArrayCommand}"
                          Width="22" Height="22" Padding="2" ToolTip.Tip="{loc:Localize Editor_Back}">
                    <Path Classes="Lucide" Data="{StaticResource lucide-arrow-left}" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right">
                  <Button x:Name="AddPropertyButton" Classes="AddPropertyBtn" IsVisible="{Binding CanAddProperty}"
                          Click="AddProperty_Click" ToolTip.Tip="{loc:Localize Property_Add}"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="10" Height="10"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{loc:Localize Property_Add}" FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeSmall}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding UndoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanUndo}" ToolTip.Tip="{loc:Localize Toolbar_Undo}"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Lucide" Data="{StaticResource lucide-undo}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <Button Command="{Binding RedoCommand}" Classes="IconBtn"
                          IsEnabled="{Binding CanRedo}" ToolTip.Tip="{loc:Localize Toolbar_Redo}"
                          Width="22" Height="22" Padding="2">
                    <Path Classes="Lucide" Data="{StaticResource lucide-redo}" Width="11" Height="11"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:FieldRow">
                    <views:FieldRowView />
                   </DataTemplate>
                 </ItemsControl.ItemTemplate>
               </ItemsControl>
             </ScrollViewer>
             <views:HelpStripView Grid.Row="2" IsVisible="{Binding EditorHelpVisible}"
                                  ShowMetaItems="True" ShowDetails="True" Spacing="4" />
          </Grid>
        </Border>

        <!-- ===== CONTENT AREA: ARRAY SPLIT MODE ===== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding IsArrayMode}">
          <!-- Shared Breadcrumb Header -->
           <Border Grid.Row="0" Classes="PanelHeader" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}">
            <DockPanel VerticalAlignment="Center">
               <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">  
                  <TextBlock Text="Array" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding EffectivePathString}" Classes="HeaderSubtitle" VerticalAlignment="Center" />
                  <Button IsVisible="{Binding NestedCtx, Converter={x:Static conv:EditorConverters.NullToBool}}"
                        Classes="IconBtn"
                        Command="{Binding ExitNestedArrayCommand}"
                        Width="22" Height="22" Padding="2" ToolTip.Tip="{loc:Localize Editor_Back}">
                  <Path Classes="Lucide" Data="{StaticResource lucide-arrow-left}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="AddPropertyBtn" IsVisible="{Binding CanAddProperty}"
                        Click="AddProperty_Click" ToolTip.Tip="{loc:Localize Property_Add}"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="10" Height="10"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{loc:Localize Property_Add}" FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding UndoCommand}" Classes="IconBtn"
                        IsEnabled="{Binding CanUndo}" ToolTip.Tip="{loc:Localize Toolbar_Undo}"
                        Width="22" Height="22" Padding="2">
                  <Path Classes="Lucide" Data="{StaticResource lucide-undo}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button Command="{Binding RedoCommand}" Classes="IconBtn"
                        IsEnabled="{Binding CanRedo}" ToolTip.Tip="{loc:Localize Toolbar_Redo}"
                        Width="22" Height="22" Padding="2">
                  <Path Classes="Lucide" Data="{StaticResource lucide-redo}" Width="11" Height="11"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" ></StackPanel>
            </DockPanel>
          </Border>
          <!-- Split Content: Cards | Detail -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240" MinWidth="160" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <!-- Card List -->
            <Border Grid.Column="0"
                    BorderThickness="0"
                    Background="{DynamicResource PanelBackgroundBrush}">
              <DockPanel>
                <Border Classes="HelpStripCompact" DockPanel.Dock="Top"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}"
                        Padding="6,12" IsVisible="{Binding ArrayHelpVisible}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding ArrayHelpInfo.Description}" Classes="HelpDescription"
                               IsVisible="{Binding ArrayHelpInfo.Description, Converter={x:Static conv:EditorConverters.NullToBool}}" />
                  </StackPanel>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}"
                        DockPanel.Dock="Bottom" Padding="8,12">
                  <Button x:Name="AddCardButton" Classes="DashedBtn" Command="{Binding AddCardCommand}"
                          IsEnabled="{Binding ArrayHelpInfo.IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                          HorizontalAlignment="Stretch" Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <Path Classes="Lucide" Data="{StaticResource lucide-plus}" Width="12" Height="12"
                                Stroke="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{loc:Localize Array_Add}" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontJetBrainsMono}" FontSize="{DynamicResource EditorFontSizeBase}" />
                    </StackPanel>
                  </Button>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
                  <ItemsControl ItemsSource="{Binding CardItems}" Margin="10,12"
                                Focusable="True" IsTabStop="True"
                                GotFocus="Cards_GotFocus">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CardItem">
                        <Border Classes="CardItem" Margin="0,0,0,6"
                                Focusable="True" IsTabStop="False"
                                KeyDown="CardItem_KeyDown"
                                BorderBrush="{Binding IsSelected, Converter={x:Static conv:EditorConverters.CardSelectedToBorderBrush}}"
                                Tapped="CardItem_Tapped">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                           FontFamily="{StaticResource FontJetBrainsMono}"
                                           FontSize="{DynamicResource EditorFontSizeBase}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <Path Classes="Lucide" Data="{StaticResource lucide-circle-alert}" Width="10" Height="10"
                                          Stroke="{DynamicResource ErrorBrush}"
                                          IsVisible="{Binding HasErrors}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Preview}" Classes="CardPreview" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Classes="IconBtn" Width="20" Height="20" Padding="2"
                                    IsEnabled="{Binding ElementName=RootWindow, Path=DataContext.ArrayHelpInfo.IsReadOnly, Converter={x:Static conv:EditorConverters.InverseBool}}"
                                    Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteCardCommand}"
                                    CommandParameter="{Binding Index}"
                                    Tapped="CardDelete_Tapped" ToolTip.Tip="{loc:Localize Action_Delete}">
                              <Path Classes="Lucide" Data="{StaticResource lucide-trash-2}" Width="12" Height="12"
                                        Stroke="{DynamicResource TextTertiaryBrush}" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1"
                          Theme="{StaticResource PanelSplitterTheme}"
                          BorderBrush="{DynamicResource CardSplitBrush}" />
            <!-- Detail Panel -->
            <Border x:Name="ArrayDetailPanel" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}">
              <Grid RowDefinitions="*,Auto">
                <Border Grid.Row="0" IsVisible="{Binding ShowEmptyDetailState}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{loc:Localize Editor_NoItemSelected}"
                             Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="{DynamicResource EditorFontSizeBase}" />
                </Border>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasObjectFields}">
                  <ItemsControl ItemsSource="{Binding ObjectFields}" Margin="12,14">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:FieldRow">
                        <views:FieldRowView />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasScalarDetail}">
                  <DockPanel>
                    <Border Classes="PanelHeader" DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource PanelBorderBrush}" Padding="14,0">
                      <TextBlock Text="Value" Classes="HeaderLabel"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="8" Margin="12,14" VerticalAlignment="Top">
                      <TextBlock Text="Value" Classes="FieldLabel" />
                      <TextBox x:Name="ScalarDetailTextBox" Text="{Binding DetailScalarText}" Classes="EditorInput" HorizontalAlignment="Stretch"
                               GotFocus="ScalarDetail_GotFocus" KeyDown="ScalarDetail_KeyDown"
                               LostFocus="ScalarDetail_LostFocus" />
                    </StackPanel>
                  </DockPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasDetailArray}">
                  <views:FieldEditorView Margin="12,14" VerticalAlignment="Top"
                                         DataContext="{Binding DetailArrayRow}" />
                </ScrollViewer>
                <views:HelpStripView Grid.Row="1" IsVisible="{Binding EditorHelpVisible}"
                                     ShowMetaItems="True" ShowDetails="True" Compact="True" />
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== CONTENT AREA: SCALAR MODE ===== -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding IsScalarMode}">
          <DockPanel>
            <Border Classes="PanelHeader" DockPanel.Dock="Top">
              <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Value" Classes="HeaderLabel" />
                  <TextBlock Text="{Binding SelectedPathString}" Classes="HeaderSubtitle" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <views:FieldEditorView Margin="12,14" VerticalAlignment="Top"
                                     DataContext="{Binding ScalarRow}" />
            </ScrollViewer>
            <views:HelpStripView DockPanel.Dock="Bottom" IsVisible="{Binding EditorHelpVisible}" ShowMetaItems="True" />
          </DockPanel>
        </Border>

      </Grid>
    </DockPanel>

    </Panel>

    <!-- ===== DIFF OVERLAY ===== -->
    <Border IsVisible="{Binding Diff.IsOpen}" Classes="DiffOverlay">
      <Border Classes="DiffPanel"
              Width="{Binding $parent[Window].Bounds, Converter={x:Static conv:EditorConverters.WindowBoundsToDiffWidth}}"
              Height="{Binding $parent[Window].Bounds, Converter={x:Static conv:EditorConverters.WindowBoundsToDiffHeight}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border Classes="PanelHeader" DockPanel.Dock="Top">
            <DockPanel VerticalAlignment="Center">
              <Button DockPanel.Dock="Right" Classes="IconBtn"
                      Command="{Binding CloseDiffCommand}" Width="22" Height="22" Padding="2"
                      ToolTip.Tip="{loc:Localize Action_Close}">
                <Path Classes="Lucide" Data="{StaticResource lucide-x}" Width="12" Height="12"
                      Stroke="{DynamicResource TextSecondaryBrush}" />
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Diff_Title}" Classes="HeaderLabel" />
                <TextBlock Text="{Binding Diff.SummaryText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource EditorFontSizeBase}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <views:DiffView DataContext="{Binding Diff}" />
        </DockPanel>
      </Border>
    </Border>

  </Panel>

</Window>
