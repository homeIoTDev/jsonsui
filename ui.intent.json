{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "confix-json-editor",
  "title": "ConfixJson Editor – UI Intent Specification",
  "description": "A technology-neutral specification for a schema-driven JSON configuration editor. Captures layout, component intents, interaction patterns, and visual design independently of any UI framework (React, Avalonia, Flutter, Blazor, etc.).",
  "application": {
    "name": "JSON Editor",
    "purpose": "Edit a structured JSON configuration file with schema-driven guidance, inline validation, and a tree-based navigation.",
    "document_type": "apollo-gateway.config.json",
    "language": "en",
    "theme_modes": ["light", "dark"],
    "default_theme": "dark"
  },
  "layout": {
    "root": {
      "type": "vertical-stack",
      "name": "application-shell",
      "fills_viewport": true,
      "overflow": "hidden",
      "children": [
        {
          "id": "top-header",
          "type": "toolbar",
          "height": 38,
          "fixed": true,
          "borders": { "bottom": true }
        },
        {
          "id": "body",
          "type": "horizontal-stack",
          "flex": 1,
          "min_size": 0,
          "children": []
        }
      ]
    },
    "body_variants": {
      "description": "The body area adapts its layout based on the current editing mode. The tree panel is always present on the left.",
      "variants": [
        {
          "mode": "text-editor",
          "condition": "textMode === true",
          "zones": [
            { "id": "tree-panel", "width": 240, "fixed": true, "borders": { "right": true } },
            { "id": "text-editor-zone", "flex": 1, "layout": "vertical-stack" }
          ]
        },
        {
          "mode": "split-view",
          "condition": "selected node is an array OR nestedCtx is active",
          "zones": [
            { "id": "tree-panel", "width": 240, "fixed": true, "borders": { "right": true } },
            { "id": "card-list-panel", "width": 240, "fixed": true, "borders": { "right": true } },
            { "id": "detail-panel", "flex": 1, "min_width": 0 }
          ]
        },
        {
          "mode": "object-editor",
          "condition": "selected node is an object (not array)",
          "zones": [
            { "id": "tree-panel", "width": 240, "fixed": true, "borders": { "right": true } },
            { "id": "object-editor-zone", "flex": 1, "layout": "vertical-stack" }
          ]
        },
        {
          "mode": "scalar-editor",
          "condition": "selected node is a scalar (string, number, boolean, null)",
          "zones": [
            { "id": "tree-panel", "width": 240, "fixed": true, "borders": { "right": true } },
            { "id": "scalar-editor-zone", "flex": 1, "layout": "vertical-stack" }
          ]
        }
      ]
    }
  },
  "panels": {
    "top-header": {
      "role": "Application header bar",
      "layout": "horizontal-stack",
      "alignment": "center",
      "padding": { "horizontal": 14 },
      "gap": 12,
      "slots": [
        {
          "id": "app-title",
          "type": "label",
          "text": "JSON EDITOR",
          "style": "heading"
        },
        {
          "id": "document-filename",
          "type": "label",
          "text_from": "document.filename",
          "style": "muted-mono"
        },
        {
          "id": "spacer",
          "type": "flex-spacer"
        },
        {
          "id": "error-count",
          "type": "status-badge",
          "condition": "errors.length > 0",
          "style": "error",
          "text_from": "error_count_label"
        },
        {
          "id": "save-confirmation",
          "type": "status-badge",
          "condition": "saved === true",
          "style": "success",
          "text": "✓ saved",
          "auto_dismiss_ms": 2000
        }
      ]
    },
    "tree-panel": {
      "role": "Hierarchical navigation of the JSON document structure",
      "layout": "vertical-stack",
      "zones": [
        {
          "id": "tree-scroll-area",
          "type": "scroll-container",
          "flex": 1,
          "overflow": "vertical-auto",
          "padding": { "vertical": 4 },
          "content": "tree-widget"
        },
        {
          "id": "tree-toolbar",
          "type": "toolbar",
          "height": 36,
          "fixed": true,
          "borders": { "top": true },
          "layout": "horizontal-evenly-spaced",
          "padding": { "horizontal": 6 },
          "items": [
            { "id": "theme-toggle", "type": "icon-button", "action": "toggle_theme", "icons": { "light": "sun", "dark": "moon" }, "tooltip_from": "theme_toggle_label" },
            { "id": "text-mode-toggle", "type": "icon-button", "action": "toggle_text_mode", "icon": "code", "toggleable": true, "tooltip": "Toggle text mode" },
            { "id": "save-button", "type": "icon-button", "action": "save", "icon": "save", "tooltip": "Save" },
            { "id": "diff-button", "type": "icon-button", "action": "open_diff", "icon": "diff", "tooltip": "Show diff" }
          ]
        }
      ]
    },
    "card-list-panel": {
      "role": "List of items in a selected array, with item selection, delete, and add",
      "layout": "vertical-stack",
      "min_size": 0,
      "header": {
        "type": "panel-header",
        "label": "ARRAY",
        "subtitle_from": "card_array_path_string",
        "actions": [
          {
            "id": "back-button",
            "type": "icon-button",
            "label": "zurück",
            "icon": "arrow-left",
            "action": "exit_nested_array",
            "condition": "nestedCtx !== null"
          }
        ]
      },
      "body": {
        "type": "scroll-container",
        "flex": 1,
        "overflow": "vertical-auto",
        "padding": "10px 12px",
        "gap": 6,
        "content": "card-list-widget"
      },
      "footer": {
        "type": "add-button-bar",
        "borders": { "top": true },
        "padding": "8px 12px",
        "button": {
          "type": "dashed-button",
          "label": "Hinzufügen",
          "icon": "plus",
          "action": "add_array_item",
          "width": "full"
        }
      }
    },
    "detail-panel": {
      "role": "Property editor for the selected object, array item, or scalar value",
      "layout": "vertical-stack",
      "min_size": 0,
      "header": {
        "type": "panel-header",
        "label": "DETAIL",
        "subtitle_from": "detail_path_string"
      },
      "body_variants": [
        {
          "condition": "no item selected (activeCardIndex === null)",
          "content": { "type": "empty-state", "message": "Kein Item ausgewählt" }
        },
        {
          "condition": "selected item is an object",
          "layout": "vertical-stack",
          "zones": [
            { "id": "object-grid-scroll", "type": "scroll-container", "flex": 1, "overflow": "vertical-auto", "content": "object-grid-widget" },
            { "id": "detail-help-strip", "type": "help-strip", "compact": true }
          ]
        },
        {
          "condition": "selected item is an array",
          "content": { "type": "empty-state", "message": "Array — select in left panel" }
        },
        {
          "condition": "selected item is a scalar",
          "layout": "vertical-stack",
          "zones": [
            { "id": "scalar-field-scroll", "type": "scroll-container", "flex": 1, "overflow": "vertical-auto", "padding": "12px 14px", "content": "scalar-field-widget" },
            { "id": "detail-help-strip", "type": "help-strip", "compact": true }
          ]
        }
      ]
    },
    "object-editor-zone": {
      "role": "Full-width property grid for editing an object",
      "layout": "vertical-stack",
      "header": {
        "type": "panel-header",
        "label": "OBJECT",
        "subtitle_from": "selected_path_string"
      },
      "zones": [
        { "id": "object-grid-scroll", "type": "scroll-container", "flex": 1, "overflow": "vertical-auto", "content": "object-grid-widget" },
        { "id": "object-help-strip", "type": "help-strip" }
      ]
    },
    "scalar-editor-zone": {
      "role": "Simple scalar value editor",
      "layout": "vertical-stack",
      "header": {
        "type": "panel-header",
        "label": "VALUE",
        "subtitle_from": "selected_path_string"
      },
      "zones": [
        { "id": "scalar-field-scroll", "type": "scroll-container", "flex": 1, "overflow": "vertical-auto", "padding": "12px 14px", "content": "scalar-field-widget" },
        { "id": "scalar-help-strip", "type": "help-strip" }
      ]
    },
    "text-editor-zone": {
      "role": "Raw JSON text editor with live parsing",
      "layout": "vertical-stack",
      "header": {
        "type": "panel-header",
        "label": "TEXT",
        "subtitle_from": "text_editor_path_string"
      },
      "zones": [
        { "id": "text-editor-body", "type": "scroll-container", "flex": 1, "overflow": "vertical-auto", "padding": "12px 14px", "content": "text-editor-widget" },
        { "id": "text-help-strip", "type": "help-strip" }
      ]
    },
    "diff-modal": {
      "role": "Modal overlay showing a line-by-line diff between original and current JSON",
      "type": "modal-overlay",
      "condition": "showDiff === true",
      "backdrop": "semi-transparent-dark",
      "position": "fixed-fullscreen",
      "z_index": 100,
      "panel": {
        "type": "card",
        "header": { "type": "panel-header", "label": "DIFF — original vs. current", "actions": [{ "type": "icon-button", "icon": "close", "action": "close_diff" }] },
        "body": {
          "type": "scroll-container",
          "flex": 1,
          "overflow": "vertical-auto",
          "content": "diff-lines-widget"
        }
      }
    }
  },
  "widgets": {
    "tree-widget": {
      "description": "A recursively nested outline view of the JSON document. Each node shows a label, a type tag (e.g. {3}, [5], true, 123, \"text\"), and optional error indicator.",
      "behavior": {
        "click": "Select this node in the tree. If the node is an expandable object, also toggle expansion.",
        "hover": "Highlight row background (non-selected rows only)."
      },
      "node_types": {
        "root": { "label": "root", "icon": "chevron-open", "expandable": true, "style": "accent-bold" },
        "object": { "icon": "chevron", "expandable": true, "type_tag": "{N fields}", "style": "bold" },
        "array": { "icon": "bracket", "expandable": false, "type_tag": "[N items]", "style": "accent-color" },
        "scalar": { "icon": "dot", "expandable": false, "type_tag_from": "scalar_value_preview", "style": "normal" }
      },
      "states": {
        "selected": { "background": "selected-bg", "border_left": "selected-border" },
        "expanded": { "chevron_rotation": "90deg" },
        "has_error": { "show_error_icon": true },
        "hover": { "background": "hover-bg" }
      },
      "indentation": { "per_level_px": 14, "base_px": 8 }
    },
    "card-list-widget": {
      "description": "A scrollable list of cards, each representing one item in a JSON array. Each card shows an index, error indicator (if any), a delete button, and a content preview.",
      "behavior": {
        "click_card": "Select this array item for editing in the detail panel",
        "click_delete": "Remove this item from the array (stop propagation)",
        "click_add": "Append a new template item to the array and auto-select it"
      },
      "card_preview": {
        "description": "Preview shows up to 3 primitive key:value pairs for object items, or JSON.stringify for non-objects.",
        "max_pairs": 3
      },
      "states": {
        "selected": { "border": "selected-border", "background": "selected-bg" },
        "has_error": { "border": "error-border" },
        "hover": { "border": "border-strong" }
      },
      "delete_button": {
        "type": "icon-button",
        "icon": "trash",
        "style": "error",
        "position": "top-right-corner"
      },
      "add_button": {
        "style": "dashed-border",
        "icon": "plus",
        "label": "Hinzufügen",
        "width": "full",
        "hover_style": "accent"
      }
    },
    "object-grid-widget": {
      "description": "A property grid that iterates over all fields of a JSON object and renders an appropriate editor for each field based on its type and schema.",
      "layout": "vertical-stack",
      "gap": 8,
      "field_rows": [
        {
          "condition": "field is a nested object",
          "row": {
            "layout": "grid",
            "columns": ["130px label", "1fr value"],
            "gap": 10,
            "style": "dimmed",
            "content": [
              { "type": "label", "text_from": "field_key", "style": "muted-mono" },
              { "type": "label", "text_from": "nested_object_summary", "style": "muted-mono" }
            ]
          }
        },
        {
          "condition": "field is an array",
          "row": {
            "layout": "grid",
            "columns": ["130px label", "1fr value"],
            "gap": 10,
            "content": [
              { "type": "label", "text_from": "field_key", "style": "deprecation-aware" },
              {
                "type": "drill-array-button",
                "icon": "bracket",
                "text_from": "array_item_count",
                "action": "drill_into_array",
                "show_error_icon_if": "field_has_errors",
                "trailing_icon": "arrow-right"
              }
            ]
          }
        },
        {
          "condition": "field is a scalar",
          "row": {
            "layout": "grid",
            "columns": ["130px label", "1fr value"],
            "gap": 10,
            "behavior": { "click_row": "focus_field" },
            "content": [
              {
                "type": "label",
                "text_from": "field_key",
                "required_marker_if": "schema.required",
                "style": "deprecation-aware"
              },
              { "type": "scalar-field-widget", "path_from": "field_path", "value_from": "field_value" }
            ]
          }
        }
      ]
    },
    "scalar-field-widget": {
      "description": "Renders the appropriate form control for a primitive JSON value, driven by the value's type and schema constraints.",
      "render_rules": [
        {
          "condition": "value is boolean",
          "control": "checkbox",
          "label": "current_boolean_value_as_text"
        },
        {
          "condition": "schema has enum constraint",
          "control": "dropdown",
          "options_from": "schema.enum",
          "value_from": "field_value"
        },
        {
          "condition": "value is number",
          "control": "number-input",
          "min_from": "schema.minimum",
          "max_from": "schema.maximum"
        },
        {
          "condition": "value is string or null",
          "control": "text-input"
        }
      ],
      "states": {
        "read_only": { "disabled": true, "opacity": 0.6 },
        "deprecated": { "border_color": "warn" },
        "has_error": { "border_color": "error" },
        "focused": { "border_color": "accent", "box_shadow": "accent-glow" }
      }
    },
    "help-strip": {
      "description": "A context-sensitive information bar at the bottom of editor panels. Shows schema documentation, validation errors, constraints, and metadata for the currently focused field.",
      "layout": "vertical-stack",
      "borders": { "top": true },
      "padding": { "compact": "6px 12px", "default": "8px 14px" },
      "slots": [
        {
          "id": "field-errors",
          "condition": "field has validation errors",
          "type": "error-banner",
          "messages_from": "field_error_messages"
        },
        {
          "id": "field-meta",
          "type": "flex-wrap-row",
          "gap": "3px 12px",
          "items": [
            { "type": "description", "text_from": "schema.description", "fallback": "path_string_in_italic" },
            { "type": "badge", "label": "DEPRECATED", "condition": "schema.deprecated", "style": "warn" },
            { "type": "badge", "label": "READ-ONLY", "condition": "schema.readOnly", "style": "muted" },
            { "type": "default-value", "condition": "schema.default !== undefined", "format": "default: {value}" },
            { "type": "range-indicator", "condition": "schema has min or max", "format": "range: {min} – {max}" },
            { "type": "comment", "condition": "schema.$comment", "text_from": "schema.$comment", "style": "italic" }
          ]
        }
      ]
    },
    "text-editor-widget": {
      "description": "A full-bleed textarea for editing JSON in raw text form. Parses JSON on each keystroke and shows parse errors in a banner above the textarea.",
      "layout": "vertical-stack",
      "gap": 8,
      "slots": [
        {
          "id": "parse-error-banner",
          "condition": "parse_error !== null",
          "type": "error-banner",
          "prefix": "Parse error: ",
          "text_from": "parse_error_message"
        },
        {
          "id": "textarea",
          "type": "multiline-text-input",
          "flex": 1,
          "resize": "none",
          "monospace": true,
          "value_from": "json_formatted_text",
          "on_change": "parse_and_update_json"
        }
      ]
    },
    "diff-lines-widget": {
      "description": "A simple line-by-line text diff between original and current JSON. Computed by comparing stringified line arrays.",
      "lines": [
        {
          "condition": "original_line === current_line",
          "type": "same",
          "marker": " ",
          "marker_color": "dim",
          "background": "transparent"
        },
        {
          "condition": "original_line exists but differs",
          "type": "removed",
          "marker": "−",
          "marker_color": "error",
          "background": "error-tinted"
        },
        {
          "condition": "current_line exists but differs",
          "type": "added",
          "marker": "+",
          "marker_color": "accent",
          "background": "accent-tinted"
        }
      ]
    },
    "panel-header": {
      "description": "A thin header bar for panels with label, optional subtitle, and optional action slot.",
      "layout": "horizontal-stack",
      "height": 34,
      "padding": "7px 12px",
      "borders": { "bottom": true },
      "gap": 8,
      "alignment": "center",
      "slots": [
        { "id": "label", "type": "label", "text_from": "label", "style": "heading-uppercase-mono" },
        { "id": "subtitle", "type": "label", "condition": "subtitle present", "text_from": "subtitle", "style": "accent-mono" },
        { "id": "spacer", "type": "flex-spacer" },
        { "id": "action-slot", "type": "slot", "condition": "action_content present", "content_from": "action_content" }
      ]
    }
  },
  "data_models": {
    "json_document": {
      "description": "A mutable JSON document represented as nested records and arrays. This is the single source of truth for the editor.",
      "types": {
        "JsonValue": "string | number | boolean | null | JsonObject | JsonArray",
        "JsonObject": "Record<string, JsonValue>",
        "JsonArray": "JsonValue[]"
      },
      "operations": [
        { "name": "get_by_path", "description": "Navigate to a value by an array of string keys/indices." },
        { "name": "set_by_path", "description": "Immutable update: return a new document with the value at the given path replaced." },
        { "name": "delete_array_item", "description": "Remove an item at a given index from an array path." },
        { "name": "add_array_item", "description": "Append a new template item (based on first item's shape) to an array path." }
      ]
    },
    "schema": {
      "description": "A flat key-value mapping from dot-separated path patterns to schema metadata. Array index placeholders are represented as '[]'.",
      "fields": {
        "description": "Human-readable documentation for the field.",
        "default": "Default value shown in the help strip.",
        "deprecated": "Warn badge shown; value can still be edited.",
        "readOnly": "Field is disabled for editing.",
        "$comment": "Additional developer note shown in italic.",
        "enum": "List of allowed string values; renders as dropdown.",
        "minimum": "Numeric lower bound for validation.",
        "maximum": "Numeric upper bound for validation.",
        "required": "Field must not be empty, null, or blank string."
      }
    },
    "selection": {
      "description": "The currently selected node in the tree, represented as a string array path.",
      "type": "NodePath = string[]"
    },
    "tree_expansion": {
      "description": "A set of path keys (joined with '/') representing which tree nodes are expanded.",
      "type": "Set<string>"
    },
    "validation": {
      "description": "Validation errors are computed from the current JSON document against the schema. Errors are a flat list of {path, message} objects.",
      "error_type": "{ path: string, message: string }",
      "rules": [
        { "name": "minimum", "message": "Must be ≥ {min}", "condition": "numeric value < schema.minimum" },
        { "name": "maximum", "message": "Must be ≤ {max}", "condition": "numeric value > schema.maximum" },
        { "name": "required", "message": "Required field is empty", "condition": "schema.required AND (value is '' or null or undefined)" }
      ]
    },
    "array_drilldown": {
      "description": "Supports nested array navigation. A NestedCtx records which array path is being drilled into and which card is selected.",
      "type": "{ arrayPath: NodePath, cardIndex: number | null } | null"
    }
  },
  "application_state": {
    "description": "The complete set of mutable state variables that drive the UI.",
    "variables": {
      "dark": { "type": "boolean", "default": true, "description": "Dark/light theme toggle." },
      "json": { "type": "JsonObject", "description": "The editable JSON document." },
      "original_json": { "type": "JsonObject", "description": "Frozen snapshot of the initial document (for diff comparison)." },
      "selected_path": { "type": "NodePath", "description": "Currently selected node in the tree." },
      "expanded": { "type": "Set<string>", "description": "Expanded tree node keys." },
      "text_mode": { "type": "boolean", "default": false, "description": "Toggle between form-editor and raw text-editor views." },
      "show_diff": { "type": "boolean", "default": false, "description": "Toggle the diff modal overlay." },
      "saved": { "type": "boolean", "default": false, "description": "Brief 'saved' confirmation toast flag. Auto-resets after 2 seconds." },
      "card_index": { "type": "number | null", "description": "Selected card index in the top-level card list." },
      "nested_ctx": { "type": "NestedCtx | null", "default": null, "description": "Drill-down context for nested arrays." },
      "focus_field_path": { "type": "NodePath | null", "default": null, "description": "Which field is focused in the detail editor, driving the help strip context." }
    },
    "derived_values": {
      "errors": { "type": "ValidationError[]", "computed_from": "json", "description": "Recursively validates json against schema." },
      "selected_value": { "type": "JsonValue", "computed_from": "json + selected_path" },
      "is_selected_array": { "type": "boolean", "computed_from": "selected_value" },
      "is_selected_object": { "type": "boolean", "computed_from": "selected_value" },
      "card_array_path": { "type": "NodePath", "computed_from": "nested_ctx ?? selected_path" },
      "active_card_index": { "type": "number | null", "computed_from": "nested_ctx?.cardIndex ?? card_index" },
      "detail_item_path": { "type": "NodePath | null", "computed_from": "active_card_index ?? card_array_path" },
      "detail_item_value": { "type": "JsonValue | null", "computed_from": "detail_item_path" },
      "show_split_view": { "type": "boolean", "computed_from": "is_selected_array OR nested_ctx !== null" }
    }
  },
  "interaction_handlers": {
    "tree_selection": {
      "trigger": "User clicks a tree node",
      "actions": [
        "Set selected_path to the node's path.",
        "Clear nested_ctx and card_index.",
        "If the selected node is an array with items, auto-select card_index = 0."
      ]
    },
    "tree_toggle": {
      "trigger": "User clicks an expandable tree node",
      "actions": [
        "Add or remove the node's path key from the expanded set."
      ]
    },
    "change_field": {
      "trigger": "User edits a scalar field",
      "actions": [
        "Update json at the field's path via immutable set_by_path."
      ]
    },
    "text_change": {
      "trigger": "User types in the raw text editor",
      "actions": [
        "Update local text state immediately.",
        "Try JSON.parse on the text.",
        "If parse succeeds, update json at the selected path.",
        "If parse fails, show parse error banner."
      ]
    },
    "delete_card": {
      "trigger": "User clicks delete on a card",
      "actions": [
        "Remove the item at the given index from the array at the given path.",
        "Clear the active card index."
      ]
    },
    "add_card": {
      "trigger": "User clicks the add button in the card list",
      "actions": [
        "Create a template item (zeroed values based on first item's shape).",
        "Append the template to the array.",
        "Set active card index to the new item's index."
      ]
    },
    "drill_array": {
      "trigger": "User clicks an array button in the object grid",
      "actions": [
        "Set nested_ctx to { arrayPath: the_array_path, cardIndex: 0 }.",
        "Clear focus_field_path."
      ]
    },
    "exit_nested_array": {
      "trigger": "User clicks the 'zurück' back button",
      "actions": [
        "Clear nested_ctx and focus_field_path."
      ]
    },
    "save": {
      "trigger": "User clicks the save button",
      "actions": [
        "Set saved flag to true.",
        "After 2 seconds, set saved flag to false."
      ]
    },
    "toggle_theme": {
      "trigger": "User clicks the theme toggle button",
      "actions": ["Toggle dark boolean."]
    },
    "toggle_text_mode": {
      "trigger": "User clicks the text mode button",
      "actions": ["Toggle text_mode boolean."]
    },
    "open_diff": {
      "trigger": "User clicks the diff button",
      "actions": ["Set show_diff to true."]
    },
    "close_diff": {
      "trigger": "User clicks close on the diff modal or clicks the backdrop",
      "actions": ["Set show_diff to false."]
    },
    "focus_field": {
      "trigger": "User clicks a field row in the object grid",
      "actions": ["Set focus_field_path to the field's path."]
    }
  },
  "design_tokens": {
    "typography": {
      "fonts": {
        "mono": "'JetBrains Mono', ui-monospace, monospace",
        "sans": "'Inter', ui-sans-serif, system-ui, sans-serif"
      },
      "base_size": "13px",
      "styles": {
        "heading": { "font": "mono", "size": "11px", "weight": 700, "letter_spacing": "0.1em" },
