  "icons": {
    "description": "Semantic icon names used throughout the UI. Each maps to an SVG icon.",
    "inventory": {
      "chevron": "Right-pointing triangle, rotates 90° when expanded. 10×10.",
      "dot": "Small filled circle. 8×8.",
      "bracket": "Square brackets outline. 10×10.",
      "error": "Styled '!' in a bordered error-colored box.",
      "moon": "Crescent moon. 14×14.",
      "sun": "Sun with rays. 14×14.",
      "code": "Angle brackets (code symbol). 14×14.",
      "save": "Floppy disk. 14×14.",
      "diff": "Three horizontal lines with an arrow. 14×14.",
      "trash": "Trash can. 12×12.",
      "plus": "Plus sign. 12×12.",
      "arrow-right": "Right-pointing arrow. 11×11.",
      "arrow-left": "Left-pointing arrow (back). 11×11.",
      "close": "Multiplication sign (✕)."
    }
  },
  "routes_and_modes": {
    "text_mode": {
      "description": "When text_mode is true, the editor area shows a raw JSON textarea instead of the form-based property editor.",
      "entry_condition": "text_mode === true",
      "scope": "Edits the value at the currently selected tree path."
    },
    "form_mode": {
      "description": "When text_mode is false, the editor area shows form controls appropriate to the selected node's type.",
      "sub_modes": [
        {
          "name": "object_editor",
          "condition": "selected node is an object, not an array",
          "view": "Property grid with labeled fields."
        },
        {
          "name": "array_split_view",
          "condition": "selected node is an array OR nested_ctx is active",
          "view": "Split view: card list on the left, detail editor on the right."
        },
        {
          "name": "scalar_editor",
          "condition": "selected node is a scalar value",
          "view": "Single form control appropriate to the value type."
        }
      ]
    },
    "diff_mode": {
      "description": "A modal overlay showing a line-by-line comparison between the original JSON (frozen on load) and the current JSON.",
      "entry_condition": "show_diff === true",
      "exit": "Clicking the close button or the backdrop."
    }
  }
}
