    "spacing": {
      "tree_indent_per_level": 14,
      "tree_indent_base": 8,
      "tree_node_min_height": 24,
      "panel_header_height": 34,
      "top_header_height": 38,
      "tree_toolbar_height": 36,
      "button_padding": "3px",
      "input_padding": "5px 8px",
      "panel_padding": "12px 14px",
      "card_padding": "7px 10px",
      "help_strip_padding": "8px 14px",
      "help_strip_padding_compact": "6px 12px",
      "object_grid_gap": 8,
      "object_grid_column_label": "130px"
    },
    "radii": {
